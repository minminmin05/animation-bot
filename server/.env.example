# =========================
# BOTNOI CONFIG
# =========================
BOTNOI_API_KEY=PUT_YOUR_API_KEY_HERE

# =========================
# LLM PROVIDER CONFIGURATION
# =========================
# Primary LLM provider: 'minimax' or 'gemini'
# MiniMax is primary, Gemini is fallback only
LLM_PROVIDER=minimax

# MiniMax API Configuration
# Format options:
#   1. New format: sk-xxxxxxxxxxxxx (recommended)
#   2. Old format: groupId;apiKey
# Get your API key from: https://api.minimax.chat/
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY_HERE
MINIMAX_MODEL=abab6.5s-chat
# MiniMax API URL - customize if using a different endpoint
MINIMAX_API_URL=https://api.minimax.io/v1

# Google Gemini API Configuration (fallback or primary)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# =========================
# SUPABASE CONFIGURATION
# =========================
SUPABASE_URL=YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_KEY_HERE
